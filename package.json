{
  "name": "semantic-answer-tree",
  "version": "0.1.0",
  "description": "Explore every answer, branch by branch",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:RightL/Semantic-Answer-Tree.git"
  },
  "homepage": "https://github.com/RightL/Semantic-Answer-Tree",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 4173",
    "build": "vinext build && node scripts/check-build-privacy.mjs dist",
    "start": "vinext start --port 4173",
    "local": "node server/http.mjs",
    "mcp": "node server/mcp-server.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:privacy": "node --test \"tests/privacy/**/*.test.mjs\" && node scripts/check-build-privacy.mjs dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:browser && npm run build && npm run test:privacy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "katex": "^0.18.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
